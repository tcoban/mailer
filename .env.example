# KOFMailer - Example Environment Variables
# Copy this to .env and fill in your secrets

# Security
PII_ENCRYPTION_KEY=your-32-byte-base64-key

# MS Graph
MS_GRAPH_TENANT_ID=your-tenant-id
MS_GRAPH_CLIENT_ID=your-client-id
MS_GRAPH_CLIENT_SECRET=your-client-secret
MS_GRAPH_USER_ID=sender@example.com

# Database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/mailer
REDIS_URL=redis://localhost:6379/0
